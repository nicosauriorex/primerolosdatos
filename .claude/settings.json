{
  "permissions": {
    "allow": [
      "Bash(python pipeline/obtener_datos.py --solo-json)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(python pipeline/ver_cache.py)",
      "Bash(python pipeline/ver_cache.py *)"
    ],
    "deny": [
      "Read(./.indec_token*)",
      "Read(./indec_token.txt)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./datos/cache/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint.mjs\""
          }
        ]
      }
    ]
  }
}
